# open-tutti-server configuration (priority: real env > this file > defaults)

# Listen address for HTTP + WebSocket.
OPEN_TUTTI_LISTEN_ADDR=127.0.0.1:8080

# Public base URL used when minting share links (no trailing slash).
OPEN_TUTTI_PUBLIC_URL=https://tutti.example.com
# Remote deployments must terminate TLS in a reverse proxy before exposing
# the server. Plain HTTP is allowed only for loopback local development.

# Durable state directory (SQLite database + CAS objects).
OPEN_TUTTI_DATA_DIR=/data

# Override the SQLite path (default: <DATA_DIR>/open-tutti.db).
# OPEN_TUTTI_DATABASE_PATH=/data/open-tutti.db

# Override the CAS object directory (default: <DATA_DIR>/objects).
# OPEN_TUTTI_OBJECTS_DIR=/data/objects

# HMAC secret for session tokens. Generate with: openssl rand -hex 32
OPEN_TUTTI_SECRET=change-me

# Optional server invite code; when set, creating a room requires it.
# Leave empty for an open server.
# OPEN_TUTTI_SERVER_INVITE_CODE=let-me-in

# Grace period before an offline owner's room transfers or dissolves.
# OPEN_TUTTI_OWNER_GRACE_SECONDS=300

# Lifetime of a one-time join ticket minted by the share page.
# OPEN_TUTTI_JOIN_TICKET_TTL_SECONDS=60

# Operations between periodic workspace snapshots.
# OPEN_TUTTI_SNAPSHOT_INTERVAL_OPS=512

# debug | info | warn | error
# OPEN_TUTTI_LOG_LEVEL=info
