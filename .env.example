# Direct server runs use loopback. Compose injects a separate, non-.env local
# mode marker because Docker forwards the host loopback port to the container's
# bridge listener. That marker is accepted only with the fixed values below;
# setting a localhost URL alone never bypasses the server safety check.
# Remote deployments must use an HTTPS reverse proxy and a separate, explicit
# Compose override.
OPEN_TUTTI_LISTEN_ADDR=127.0.0.1:8080
OPEN_TUTTI_PUBLIC_URL=http://localhost:8080
OPEN_TUTTI_DATA_DIR=/data
# Required. Generate a unique value, for example: openssl rand -hex 32
OPEN_TUTTI_SECRET=
# Pending CAS reservations are per-device and expire; PUT never creates a
# durable room reference.
OPEN_TUTTI_CAS_PENDING_QUOTA_BYTES=67108864
OPEN_TUTTI_CAS_PENDING_TTL_SECONDS=900
